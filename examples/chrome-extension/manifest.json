{
  "manifest_version": 3,
  "name": "오늘의 언어",
  "version": "1.0.0",
  "description": "로컬 목록에서 오늘의 언어를 보여주고, 데모 페이지의 언어 이름만 표시합니다.",
  "action": {
    "default_title": "오늘의 언어",
    "default_popup": "popup.html"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1/*"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ]
}
